# Copy to .env only to override. Dev/test fall back to the local Docker Compose stack, so a bare checkout
# boots with zero config; in production every value below is required.

# Postgres connection string used by the API (the only database client).
DATABASE_URL=postgres://viraloderegal:viraloderegal@localhost:18753/viraloderegal

# The API's HTTP port. docker-compose.prod.yml pins the container's port in its environment: block, which
# overrides this file.
PORT=18752

# Directory holding the built SPA the API serves in production.
WEB_DIST_DIR=../web/dist

# Trust X-Forwarded-For for the real client IP (rate-limit and ban keys). Defaults to false; enable only
# behind a proxy that sets the header (Traefik in production) so it cannot be spoofed by direct clients.
TRUST_PROXY=false

# Admin auth and YouTube curation secrets. The bare /health API boots without them in dev.
YOUTUBE_API_KEY=
BETTER_AUTH_SECRET=

# SMTP credentials for admin invitation emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
